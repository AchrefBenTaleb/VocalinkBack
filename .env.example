# Server
PORT=5000
NODE_ENV=development

# Comma-separated list of allowed frontend origins (for CORS)
CLIENT_ORIGIN=http://localhost:5173

# MongoDB
# Local: mongodb://127.0.0.1:27017/vocalink
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/vocalink
MONGODB_URI=mongodb://127.0.0.1:27017/vocalink

# SMTP (used to send email notifications)
# Example with Gmail: create an "App Password" (not your normal password)
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# "Display Name" <email> used as the From address
MAIL_FROM="Vocalink" <your-email@gmail.com>

# Where internal notifications (new quote / appointment) are sent
NOTIFY_EMAIL=admin@vocalink.com
